# ============================================================================
#  MODELO das variáveis de ambiente. Este arquivo VAI para o GitHub — por isso
#  ele não tem valor nenhum de verdade dentro.
#
#  O QUE FAZER:
#  1. Faça uma cópia deste arquivo com o nome  .env.local  (na mesma pasta).
#  2. Preencha os dois valores abaixo com os dados do seu projeto Supabase:
#     painel do Supabase -> Settings -> API.
#  3. O .env.local NÃO vai para o GitHub (já está no .gitignore). Nunca troque
#     esses nomes de arquivo.
#  4. Cole os mesmos dois valores na Vercel:
#     seu projeto -> Settings -> Environment Variables.
# ============================================================================

# "Project URL" — algo como https://abcdefghijklm.supabase.co
SUPABASE_URL=

# A chave "service_role" (a SECRETA, não a "anon"/"publishable").
# Ela dá acesso total ao banco: nunca poste em print, chat ou commit.
SUPABASE_SERVICE_ROLE_KEY=
